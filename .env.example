# -----------------------------------------------------------------------------
# DiffLab 环境变量配置示例
# 复制为 .env 文件生效：cp .env.example .env
# -----------------------------------------------------------------------------

# 宿主机对外暴露端口（默认 14318）
HOST_PORT=14318

# 容器内服务端口（默认 4318）
PORT=4318

# 服务端默认 Figma Access Token（可选，网页端也可以临时填写）
FIGMA_TOKEN=

# 服务端默认 AI API Key（可选，网页端也可以临时填写）
OPENAI_API_KEY=

# OpenAI 兼容 API 基础地址（可选，默认为 https://api.openai.com/v1）
OPENAI_BASE_URL=https://api.openai.com/v1

# 默认 AI 模型 ID（可选，默认为 gpt-5.6-terra）
OPENAI_MODEL=gpt-5.6-terra

# 页面结构与元素语义绑定超时（毫秒，范围 10000–180000；默认 120000）
DIFFLAB_AI_BINDING_TIMEOUT_MS=120000

# MCP 与公共 Review 是否默认启用 AI；省略时根据 Key/API 地址自动判断
DIFFLAB_AI_ENABLED=

# MCP 转发到公共 API 的地址；同进程 Streamable HTTP 默认可省略
DIFFLAB_API_BASE_URL=http://127.0.0.1:4318

# 公共 API 与 MCP 共用的本地服务身份 Token
DIFFLAB_SERVICE_TOKEN=

# Streamable HTTP MCP 允许的 Host/Origin 主机名（不含协议和端口）
# 未配置时仅允许 localhost、127.0.0.1 和 [::1]
DIFFLAB_MCP_ALLOWED_HOSTS=
DIFFLAB_MCP_ALLOWED_ORIGINS=

# 公共 Review 背压与并发保护
# 单个 Review 内 PagePair 并发
DIFFLAB_MAX_CONCURRENT_PAGES=3
# 全服务同时执行的 PagePair 并发预算（跨 Review 共享）
DIFFLAB_MAX_CONCURRENT_PAGE_PAIRS=8
# 全服务 / 单租户同时运行的 Review 数
DIFFLAB_MAX_CONCURRENT_REVIEWS=5
DIFFLAB_MAX_CONCURRENT_REVIEWS_PER_TENANT=2
# 全服务 / 单租户最多排队的 Review 数
DIFFLAB_MAX_QUEUED_REVIEWS=100
DIFFLAB_MAX_QUEUED_REVIEWS_PER_TENANT=20
# 单租户每分钟最多提交的 Review 数
DIFFLAB_REVIEW_SUBMISSIONS_PER_MINUTE=60
# 满载后的默认重试提示秒数
DIFFLAB_CAPACITY_RETRY_AFTER_SECONDS=5

# AI 建议监控告警门禁；指标按服务 Token 所属租户隔离
# 达到最小样本后，累计比率大于等于阈值时 ai_advice_alert 变为 1
DIFFLAB_AI_ALERT_MIN_ATTEMPTS=20
DIFFLAB_AI_TIMEOUT_ALERT_RATIO=0.2
DIFFLAB_AI_EVIDENCE_DANGLING_ALERT_RATIO=0.1

# Chromium 启动参数（可选，Docker 默认包含 --no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage）
# CHROMIUM_FLAGS=

# 允许访问 DiffLab 的公网客户端 IP/CIDR，逗号分隔；留空则不限制
# 健康检查 /api/health 始终公开。仅在端口绑定 127.0.0.1 且通过 Cloudflare Tunnel 访问时启用。
DIFFLAB_ALLOWED_CLIENT_IPS=
