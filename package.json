{
  "name": "visual-acceptance-prototype",
  "private": true,
  "version": "0.0.0-prototype",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "mcp": "tsx server/mcp-stdio.ts",
    "calibrate:alignment": "tsx server/page-alignment-calibration-cli.ts",
    "calibrate:missing-modules": "tsx server/missing-module-calibration-cli.ts",
    "validate:financial-gold-set": "tsx server/financial-gold-set-cli.ts",
    "generate:prometheus-target-rules": "tsx server/prometheus-expected-targets-cli.ts",
    "test": "tsx --test server/*.test.ts src/*.test.ts src/*.test.tsx",
    "test:prometheus": "bash scripts/test-prometheus-rules.sh",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "exceljs": "^4.4.0",
    "express": "latest",
    "js-yaml": "latest",
    "jszip": "^3.10.1",
    "lucide-react": "latest",
    "multer": "^2.3.0",
    "pixelmatch": "latest",
    "playwright": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "latest",
    "@types/js-yaml": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/pixelmatch": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "overrides": {
    "qs": "6.16.0",
    "uuid": "11.1.1"
  }
}
