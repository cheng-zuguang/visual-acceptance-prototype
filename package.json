{
  "name": "visual-acceptance-prototype",
  "private": true,
  "version": "0.0.0-prototype",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "test": "tsx --test server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "express": "latest",
    "js-yaml": "latest",
    "lucide-react": "latest",
    "multer": "latest",
    "pixelmatch": "latest",
    "playwright": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/js-yaml": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/pixelmatch": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
